<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/optional_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/optional_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tvOptionalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/optional_permissions"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvOptionalSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/these_permissions_are_optional_but_improve_the_app_experience"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <!-- Usage Access Switch -->
        <LinearLayout
            android:id="@+id/row_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp"
            android:paddingHorizontal="4dp"
            android:layout_marginBottom="8dp">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:text="Usage Access"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvUsageDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Required for detecting app launches."
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary"/>
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchUsageAccess"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:useMaterialThemeColors="true"/>
        </LinearLayout>

        <!-- Notifications Switch -->
        <LinearLayout
            android:id="@+id/row_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp"
            android:paddingHorizontal="4dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:text="@string/notifications"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvNotifyDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/helps_show_alerts_when_issues_occur"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary"/>
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchNotifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:useMaterialThemeColors="true"/>
        </LinearLayout>

        <!-- Dismiss -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCloseOptional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/close"
            android:textColor="@color/black"
            android:background="@drawable/round_button_bg"
            android:backgroundTint="@color/white"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
